        "format": "time_series",
        "rawQuery": true,
        "rawSql": "SELECT COALESCE(start_date, logical_date) AS \"time\", dag_id AS metric, EXTRACT(EPOCH FROM (COALESCE(end_date, now()) - start_date)) AS value FROM dag_run WHERE start_date IS NOT NULL AND $__timeFilter(COALESCE(start_date, logical_date)) ORDER BY 1;",
