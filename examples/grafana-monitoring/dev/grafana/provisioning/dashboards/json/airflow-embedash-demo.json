    {
      "datasource": {"type": "postgres", "uid": "airflow-metadata"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "id": 7,
      "options": {"showHeader": true},
      "targets": [{
        "datasource": {"type": "postgres", "uid": "airflow-metadata"},
        "format": "table",
        "rawQuery": true,
        "rawSql": "WITH latest_run AS (SELECT DISTINCT ON (dag_id) dag_id, run_id, logical_date, start_date, end_date, state FROM dag_run ORDER BY dag_id, COALESCE(start_date, queued_at, logical_date) DESC) SELECT lr.dag_id AS \"DAG\", lr.run_id AS \"Run ID\", lr.logical_date AS \"Logical date\", lr.state AS \"Run state\", COUNT(ti.*) AS \"Tasks\", COUNT(ti.*) FILTER (WHERE ti.state = 'success') AS \"Success\", COUNT(ti.*) FILTER (WHERE ti.state = 'failed') AS \"Failed\", ROUND(100.0 * COUNT(ti.*) FILTER (WHERE ti.state IN ('success', 'skipped')) / NULLIF(COUNT(ti.*), 0), 1) AS \"Completion %\" FROM latest_run lr LEFT JOIN task_instance ti ON ti.dag_id = lr.dag_id AND ti.run_id = lr.run_id GROUP BY lr.dag_id, lr.run_id, lr.logical_date, lr.start_date, lr.end_date, lr.state;",
        "refId": "A"
      }],
      "title": "Latest DAG runs",
      "type": "table"
    }
